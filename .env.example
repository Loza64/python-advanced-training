DATABASE_URL=postgresql://app_user:change-me@localhost:5432/products
PROJECT_NAME=Products API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
LOG_LEVEL=INFO

# --- Auth / JWT ---
JWT_SECRET=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=40
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Super admin unico (sembrado automaticamente al arrancar la app) ---
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_SURNAME=

CORS_ORIGINS=http://localhost:5173,http://localhost:4200
# Never commit real credentials. Copy this file to .env locally.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/products
PROJECT_NAME=Products API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Production example:
# DATABASE_URL=postgresql://app_user:secret@db.example.com:5432/products?sslmode=require
# ENVIRONMENT=production
